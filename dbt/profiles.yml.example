# Copy to profiles.yml (git-ignored). Contains no secrets: everything comes from env vars.
edupulse:
  target: local
  outputs:
    local:
      type: duckdb
      path: "{{ env_var('EDUPULSE_DUCKDB_PATH', '/data/edupulse.duckdb') }}"
      threads: 4

    # Databricks-compatible target (requires the dbt-databricks adapter; wired up in a later phase).
    databricks:
      type: databricks
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DATABRICKS_CATALOG', 'edupulse') }}"
      schema: "{{ env_var('DATABRICKS_SCHEMA', 'default') }}"
      threads: 4
