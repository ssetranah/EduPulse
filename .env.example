# EduPulse AI -- local development settings.
# Copy to `.env` (git-ignored) and adjust. Every value here is a PLACEHOLDER for local use only.
# Never put real credentials, tokens or student data in this file or in git.

# --- General ---------------------------------------------------------------
EDUPULSE_ENV=local
# Phase 1 only supports synthetic data. Real data modes arrive with the security phases.
EDUPULSE_DATA_MODE=synthetic

# --- API / dashboard -------------------------------------------------------
API_PORT=8000
WEB_PORT=8080

# --- Local lakehouse (DuckDB file inside the shared `warehouse` volume) ------
EDUPULSE_DUCKDB_PATH=/data/edupulse.duckdb
EDUPULSE_SYNTHETIC_DIR=/data/synthetic

# --- MinIO (S3-compatible object storage for Bronze/Silver/Gold) -------------
MINIO_ROOT_USER=edupulse-local-admin
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://minio:9000
BRONZE_BUCKET=edupulse-bronze
SILVER_BUCKET=edupulse-silver
GOLD_BUCKET=edupulse-gold

# --- PostgreSQL (optional: `docker compose --profile postgres up`) ------------
POSTGRES_DB=edupulse
POSTGRES_USER=edupulse
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
